# NanoClaw Discord Configuration
# Copy this to .env and fill in your values

# Required: Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Required: Your Discord server (guild) ID
# Right-click server name > Copy Server ID (enable Developer Mode in Discord settings)
DISCORD_GUILD_ID=

# Required: The channel ID for the "main" admin channel
# Right-click channel > Copy Channel ID
DISCORD_MAIN_CHANNEL_ID=

# Optional: Assistant display name (used in status/logs)
ASSISTANT_NAME=Gandalf

# Optional: Comma-separated channel IDs to ignore
# DISCORD_IGNORE_CHANNEL_IDS=123456789,987654321


# Required: One of these for Claude authentication
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
